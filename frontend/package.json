{
  "name": "moonwalker-ui",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24.11.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite",
    "test": "npm run test:legacy && npm run test:unit",
    "test:legacy": "node --test tests/*.test.cjs",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "type-check": "vue-tsc --noEmit",
    "build": "npm run type-check && npm run build-only",
    "preview": "vite preview",
    "build-only": "vite build",
    "knip": "knip"
  },
  "dependencies": {
    "@vicons/ionicons5": "0.13.0",
    "@vue/devtools-api": "8.2.1",
    "@vueuse/core": "15.0.0",
    "axios": "1.20.0",
    "echarts": "6.1.0",
    "lightweight-charts": "5.2.1",
    "naive-ui": "2.45.3",
    "pinia": "4.0.3",
    "rete": "2.0.6",
    "rete-area-plugin": "2.3.2",
    "rete-connection-plugin": "2.0.5",
    "rete-render-utils": "2.0.3",
    "rete-vue-plugin": "2.1.3",
    "vooks": "0.2.12",
    "vue": "3.5.44",
    "vue-echarts": "8.3.2",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tsconfig/node24": "24.0.5",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.0.4",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "jsdom": "30.1.2",
    "knip": "6.41.0",
    "typescript": "6.0.3",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "vue-tsc": "3.3.13"
  },
  "overrides": {
    "follow-redirects": "1.16.1",
    "form-data": "4.0.6",
    "fsevents": "2.3.3",
    "nanoid": "3.3.18",
    "postcss": "8.5.30",
    "source-map-js": "1.2.2",
    "whatwg-url": "17.2.0"
  }
}
