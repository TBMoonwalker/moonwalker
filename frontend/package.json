{
  "name": "moonwalker-ui",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24.11.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite",
    "test": "npm run test:legacy && npm run test:unit",
    "test:legacy": "node --test tests/*.test.cjs",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "type-check": "vue-tsc --noEmit",
    "build": "npm run type-check && npm run build-only",
    "preview": "vite preview",
    "build-only": "vite build"
  },
  "dependencies": {
    "@vicons/ionicons5": "0.13.0",
    "@vue/devtools-api": "8.2.1",
    "@vueuse/core": "14.3.0",
    "axios": "1.18.1",
    "echarts": "6.1.0",
    "lightweight-charts": "5.2.0",
    "naive-ui": "2.44.1",
    "pinia": "4.0.2",
    "rete": "2.0.6",
    "rete-area-plugin": "2.3.2",
    "rete-connection-plugin": "2.0.5",
    "rete-render-utils": "2.0.3",
    "rete-vue-plugin": "2.1.3",
    "vfonts": "0.1.0",
    "vue": "3.5.40",
    "vue-echarts": "8.0.1",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@tsconfig/node24": "24.0.4",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/test-utils": "2.2.7",
    "@vue/tsconfig": "0.9.1",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.1.5",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.8"
  },
  "overrides": {
    "fsevents": "2.3.3",
    "form-data": "4.0.6",
    "nanoid": "3.3.18",
    "postcss": "8.5.26"
  }
}
