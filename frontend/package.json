{
  "name": "moonwalker-ui",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=26.0.0 <27",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite",
    "test": "npm run test:legacy && npm run test:unit",
    "test:legacy": "node --test tests/*.test.cjs",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "type-check": "vue-tsc -p tsconfig.app.json --noEmit && vue-tsc -p tsconfig.test.json --noEmit && vue-tsc -p tsconfig.node.json --noEmit",
    "build": "npm run type-check && npm run build-only",
    "preview": "vite preview",
    "build-only": "vite build",
    "knip": "knip"
  },
  "dependencies": {
    "@vicons/ionicons5": "0.13.0",
    "@vue/devtools-api": "8.2.1",
    "@vueuse/core": "15.0.0",
    "axios": "1.21.1",
    "echarts": "6.1.0",
    "lightweight-charts": "5.3.0",
    "naive-ui": "2.45.3",
    "pinia": "4.1.0",
    "rete": "2.0.6",
    "rete-area-plugin": "2.3.2",
    "rete-connection-plugin": "2.0.5",
    "rete-render-utils": "2.0.3",
    "rete-vue-plugin": "2.1.3",
    "vooks": "0.2.12",
    "vue": "3.5.45",
    "vue-echarts": "8.3.2",
    "vue-router": "5.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tsconfig/node26": "26.0.1",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.1.0",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "jsdom": "31.0.0",
    "knip": "6.45.0",
    "typescript": "6.0.3",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  },
  "overrides": {
    "follow-redirects": "1.16.2",
    "form-data": "4.0.6",
    "fsevents": "2.3.3",
    "glob": "14.0.4",
    "minimatch": "11.0.5",
    "nanoid": "3.3.18",
    "postcss": "8.5.30",
    "source-map-js": "1.2.2",
    "whatwg-url": "17.3.0",
    "zod": "4.6.7",
    "undici": "8.12.3"
  }
}
